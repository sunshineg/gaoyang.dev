---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { t } from "@/i18n";

type Props = { title: string; pageTitle?: string };

const { title, pageTitle = t.aboutTitle } = Astro.props;
---

<Layout title={pageTitle}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-heading-40 font-bold">{title}</h1>
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
