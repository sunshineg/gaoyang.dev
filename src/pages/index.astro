---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import type { CollectionEntry } from "astro:content";

const posts = getSortedPosts(await getCollection("blog"));

const featuredPosts: CollectionEntry<"blog">[] = posts.filter(
  post => post.data.featured
);
const recentPosts = posts.filter(
  post => !featuredPosts.some(featured => featured.id === post.id)
);
---

<Layout title="I’m 高阳Sunny — Hello World: Re-Act" description={SITE.desc}>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="border-b border-border pt-10 pb-8">
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-heading-40 font-bold sm:text-heading-64">
          👨‍💻 Hi there, I’m 高阳Sunny 👋
        </h1>
        <a
          target="_blank"
          href="/rss.xml"
          class="mt-2 inline-block"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-8 text-body-20 text-secondary">
        <a
          href="https://mindmux.ai/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-primary hover:text-primary-hover"
          >MindMux.ai</a
        >
        创始人兼 CEO<br />
        SegmentFault 思否联合创始人<br />
        <a
          href="https://projectbrain.md/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-primary hover:text-primary-hover"
          >ProjectBrain.md</a
        >
        发起人<br />
        Apache Answer 项目发起人
      </p>
      <p class="mt-4 text-body-16 text-muted-fg">
        Make something rocks 🎸 Better Sunny Next Time 🔆
      </p>

      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap text-label-14 text-muted-fg sm:mb-0">
              Social Links:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-heading-40 font-bold">Featured</h2>
          <ul class="mt-4">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-heading-40 font-bold">Recent Posts</h2>
          <ul class="mt-4">
            {recentPosts.map(
              (data: CollectionEntry<"blog">, index: number) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
