---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostsGrouped from "@/components/PostsGrouped.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = getSortedPosts(await getCollection("blog"));
---

<Layout title="文章｜Hello World: Re-Act">
  <Header />
  <Main pageTitle="文章" pageDesc="All the articles I've posted.">
    <div class="mt-6">
      <PostsGrouped {posts} />
    </div>
  </Main>
  <Footer />
</Layout>
