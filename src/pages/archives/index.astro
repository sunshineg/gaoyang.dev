---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostsGrouped from "@/components/PostsGrouped.astro";
import { getBlogPosts } from "@/utils/getPosts";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { t } from "@/i18n";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const posts = getSortedPosts(await getBlogPosts());
---

<Layout title={t.archivesTitle}>
  <Header />
  <Main pageTitle={t.posts} pageDesc={t.postsDesc}>
    <div class="mt-6">
      <PostsGrouped {posts} />
    </div>
  </Main>
  <Footer />
</Layout>
