---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostsGrouped from "@/components/PostsGrouped.astro";
import { getBlogPosts } from "@/utils/getPosts";
import getSortedPosts from "@/utils/getSortedPosts";
import { t } from "@/i18n";

// Rest route kept so the URL stays `/posts` — no pagination, all posts shown.
export const getStaticPaths = () => [{ params: { page: undefined } }];

const posts = getSortedPosts(await getBlogPosts());
---

<Layout title={t.postsTitle}>
  <Header />
  <Main pageTitle={t.posts} pageDesc={t.postsDesc}>
    <div class="mt-6">
      <PostsGrouped {posts} />
    </div>
  </Main>
  <Footer />
</Layout>
