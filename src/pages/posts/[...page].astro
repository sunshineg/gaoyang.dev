---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostsGrouped from "@/components/PostsGrouped.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";

// Rest route kept so the URL stays `/posts` — no pagination, all posts shown.
export const getStaticPaths = () => [{ params: { page: undefined } }];

const posts = getSortedPosts(await getCollection("blog"));
---

<Layout title="Posts — 高阳Sunny">
  <Header />
  <Main pageTitle="文章" pageDesc="All the articles I've posted.">
    <div class="mt-6">
      <PostsGrouped {posts} />
    </div>
  </Main>
  <Footer />
</Layout>
