---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data } = Astro.props;

const { title, description, ...props } = data;
---

<li class="my-3">
  <a
    href={`/posts/${id}`}
    class:list={[
      "block rounded-card border border-border-subtle bg-surface p-4 transition-colors duration-150 hover:border-border-default sm:p-5",
      "focus-visible:no-underline",
    ]}
  >
    <Heading
      class="text-heading-20 font-medium text-fg"
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
    <div class="mt-2">
      <Datetime {...props} class="text-muted-fg" />
    </div>
  </a>
</li>
